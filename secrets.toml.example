# Copiez ce fichier en .streamlit/secrets.toml (en local) ou collez son contenu dans
# « Settings > Secrets » sur Streamlit Community Cloud. Ne le publiez JAMAIS sur GitHub.

ADMIN_USERNAME = "votre_identifiant"          # lettres minuscules, chiffres, _ ou -
ADMIN_PASSWORD = "un-mot-de-passe-solide"     # 8 caractères minimum, de préférence 14+
ADMIN_EMAIL = "vous@exemple.fr"               # sert à récupérer le mot de passe administrateur

# Envoi des e-mails « mot de passe oublié » (exemple avec Gmail : il faut un mot de passe d'application,
# créé sur myaccount.google.com/apppasswords après activation de la validation en deux étapes)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "votre.adresse@gmail.com"
SMTP_PASSWORD = "mot de passe d'application"
# SMTP_FROM = "votre.adresse@gmail.com"       # facultatif : adresse affichée comme expéditeur

# Optionnel : vérification automatique des paiements Stripe (commencez par une clé de test)
# STRIPE_SECRET_KEY = "sk_test_..."

# Sauvegarde automatique des comptes dans un dépôt GitHub PRIVÉ (indispensable sur Streamlit Community Cloud,
# dont le disque est effacé à chaque redémarrage). À ne mettre QUE dans les secrets du site en ligne.
# DATA_REPO = "votre-compte/axon-data"
# DATA_TOKEN = "github_pat_..."

# Facultatif : adresse affichée dans « Nous contacter » (axonbike4@gmail.com par défaut)
# CONTACT_EMAIL = "axonbike4@gmail.com"
